#!/usr/bin/env python3
"""
Single device Python training launcher.

Usage:
    py_train train.py [args...]
"""

import os
import sys
import subprocess


def main():
    if len(sys.argv) < 2:
        print("Usage: py_train <train_script.py> [args...]")
        sys.exit(1)

    run_file = sys.argv[1]
    extra_args = sys.argv[2:]

    os.environ['PARALLEL_TYPE'] = 'none'

    cmd = [sys.executable, run_file] + extra_args
    print(f"[py_train] Running: {' '.join(cmd)}")

    result = subprocess.run(cmd)
    sys.exit(result.returncode)


if __name__ == '__main__':
    main()
